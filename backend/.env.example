# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=8080

# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/chatty

# Session Secrets (Generate random strings for production)
SESSION_SECRET=your-session-secret-here
EXPRESS_SESSION_SECRET=your-express-session-secret-here

# JWT Secrets (Generate random strings for production)
ACCESS_TOKEN_SECRET=your-access-token-secret-here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here
REFRESH_TOKEN_EXPIRY=10d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Server URL
FREEAPI_HOST_URL=http://localhost:8080

# Generate secrets using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"